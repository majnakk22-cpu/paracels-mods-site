---
// Реакции и комментарии через giscus (хранятся в GitHub Discussions репозитория сайта)
import { SITE } from '../site.config';
import { giscusTerm } from '../lib/mods';
interface Props { slug: string; bg: string }
const { slug, bg } = Astro.props;
// Светлый фон мода → светлая тема виджета, тёмный → прозрачная тёмная
const hex = bg.replace('#', '');
const full = hex.length === 3 ? hex.split('').map((c) => c + c).join('') : hex.slice(0, 6);
const [r, g, b] = [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16) / 255);
const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
const theme = isNaN(lum) || lum < 0.5 ? 'transparent_dark' : 'light';
---
<section class="feedback" id="feedback">
  <h2>Реакции и отзывы</h2>
  <p class="feedback-hint">Поставь реакцию или напиши отзыв — нужен вход через GitHub.</p>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={SITE.repo}
    data-repo-id={SITE.giscus.repoId}
    data-category={SITE.giscus.category}
    data-category-id={SITE.giscus.categoryId}
    data-mapping="specific"
    data-term={giscusTerm(slug)}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={theme}
    data-lang="ru"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>
