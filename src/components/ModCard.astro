---
import ModIcon from './ModIcon.astro';
import Icon from './Icon.astro';
import type { ModInfo } from '../lib/mods';
import { url, formatDate, compact } from '../lib/url';
import { SITE, STATUS_LABEL } from '../site.config';

interface Props { info: ModInfo; index: number }
const { info, index } = Astro.props;
const d = info.mod.data;
const search = [d.name, d.summary, d.modid, ...d.categories].join(' ').toLowerCase();
---
<a
  class="mod-card"
  href={url(`/mods/${info.slug}/`)}
  style={`--card-accent:${d.theme.accent}`}
  data-search={search}
  data-cats={JSON.stringify(d.categories)}
  data-status={d.status}
  data-name={d.name.toLowerCase()}
  data-updated={info.updated?.getTime() ?? 0}
  data-downloads={info.downloads ?? 0}
  data-order={index}
>
  <ModIcon name={d.name} icon={d.icon} />
  <div>
    <h3>{d.name}</h3><span class="by">от {SITE.author}</span>
    <p class="sum">{d.summary}</p>
    <div class="tags">
      <span class={`chip status status-${d.status}`}>{STATUS_LABEL[d.status]}</span>
      {d.categories.map((c) => <span class="chip">{c}</span>)}
    </div>
  </div>
  <div class="meta">
    {info.downloads !== undefined
      ? <span><b>{compact(info.downloads)}</b> скачиваний</span>
      : info.latest && <span><b>{info.latest.version}</b></span>}
    <span>{d.loader} · {d.mcVersions[0]}</span>
    {info.updated && <span><Icon name="clock" />{formatDate(info.updated)}</span>}
  </div>
</a>
