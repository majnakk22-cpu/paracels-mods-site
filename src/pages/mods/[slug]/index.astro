---
import { render } from 'astro:content';
import ModLayout from '../../../layouts/ModLayout.astro';
import Giscus from '../../../components/Giscus.astro';
import { getMods, giscusEnabled } from '../../../lib/mods';

export async function getStaticPaths() {
  const mods = await getMods();
  return mods.map((info) => ({ params: { slug: info.slug }, props: { info } }));
}
const { info } = Astro.props;
const { Content } = await render(info.mod);
---
<ModLayout info={info} tab="overview">
  <article class="prose"><Content /></article>
  {giscusEnabled() && <Giscus slug={info.slug} bg={info.mod.data.theme.bg} />}
</ModLayout>
