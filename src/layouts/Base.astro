---
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/url';
import { googleFontsHref } from '../lib/theme';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  style?: string; // CSS-переменные темы мода
  bodyClass?: string;
  fonts?: string[];
  extraCss?: string;
  hub?: boolean; // общий стиль сайта (со светлой темой)
  ogImage?: string;
}
const { title, description = SITE.description, style, bodyClass, fonts = [], extraCss, hub = true, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const fontsHref = googleFontsHref(['Manrope', 'Unbounded', 'JetBrains Mono', ...fonts]);
const path = Astro.url.pathname;
const isHome = path === url('/') || path === url('/').replace(/\/$/, '');
---
<!doctype html>
<html lang={SITE.lang} class:list={[hub && 'hub']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(url(ogImage), Astro.site).href} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    {extraCss && <link rel="stylesheet" href={url(extraCss)} />}
    {hub && (
      <script is:inline>
        try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
      </script>
    )}
  </head>
  <body class={bodyClass} style={style}>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url('/')}>
          <span class="brand-mark"><Icon name="cube" /></span>
          {SITE.title}
        </a>
        <nav class="nav">
          <a href={url('/')} aria-current={isHome ? 'page' : undefined}>Моды</a>
          {SITE.github && <a class="hide-sm" href={SITE.github} target="_blank" rel="noopener">GitHub</a>}
          {SITE.discord && <a class="hide-sm" href={SITE.discord} target="_blank" rel="noopener">Discord</a>}
          {hub && (
            <button class="theme-toggle" type="button" aria-label="Сменить тему" id="theme-toggle">
              <Icon name="sun" />
            </button>
          )}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span>Не связано с Mojang и Microsoft.</span>
      </div>
    </footer>
    {hub && (
      <script is:inline>
        (function () {
          var b = document.getElementById('theme-toggle');
          if (!b) return;
          b.addEventListener('click', function () {
            var root = document.documentElement;
            var cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            var next = cur === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        })();
      </script>
    )}
  </body>
</html>
